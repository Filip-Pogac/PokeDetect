# Copy to .env and adjust. All values are optional and have defaults.

# Security — MUST be changed for any real deployment.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default)
DATABASE_URL=sqlite:///./pokedetect.db

# Pokemon TCG API — optional key raises rate limits (get one at https://pokemontcg.io)
POKEMONTCG_API_KEY=

# Frontend origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR engine: easyocr | tesseract | none
OCR_ENGINE=easyocr

# Card matching pipeline
MATCH_CANDIDATE_LIMIT=40
MATCH_VISUAL_RERANK_LIMIT=18
MATCH_FINAL_LIMIT=8
ENABLE_VISUAL_RERANK=true
IMAGE_FETCH_TIMEOUT_SECONDS=3.0
