# Copy to .env and adjust. All values are optional and have defaults.

# Security — MUST be changed for any real deployment.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database. Normally you do NOT set this here: `neon link` writes DATABASE_URL
# into the repo-root .env.local, which is loaded first and wins over this file
# (see app/config.py). Set it below only to deliberately override that, e.g. to
# point a local run at a SQLite file instead:
# DATABASE_URL=sqlite:///./pokedetect.db

# Connection pool (ignored for SQLite). Small: every serverless instance keeps
# its own pool against the database's connection limit.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_CONNECT_TIMEOUT_SECONDS=10

# Card database: TCGdex — free, no API key or signup needed
TCGDEX_BASE_URL=https://api.tcgdex.net/v2/en
CARD_API_TIMEOUT_SECONDS=15.0

# Frontend origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR engine: gemini | easyocr | tesseract | none
# "gemini" reads the card with Google's vision model and falls back to the
# local EasyOCR pipeline whenever it cannot answer (no key, rate limit, empty
# reading), so it needs GEMINI_API_KEY below to do anything.
OCR_ENGINE=easyocr

# Gemini vision OCR. Key from https://aistudio.google.com/apikey - the free
# tier covers Flash models. Only read when OCR_ENGINE=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=20.0
GEMINI_MAX_IMAGE_EDGE=1600

# Card matching pipeline
MATCH_CANDIDATE_LIMIT=250
MATCH_VISUAL_RERANK_LIMIT=24
# How many matches the scan returns. High so the list is every printing of the
# card rather than a truncated handful.
MATCH_FINAL_LIMIT=60
ENABLE_VISUAL_RERANK=true
# Weight of the perceptual-hash signal, and the name score below which it is
# ignored entirely. Kept low: a phone photo's phash is noisy enough that at a
# higher weight it promotes a different Pokemon over an exact name match.
MATCH_VISUAL_WEIGHT=0.35
MATCH_VISUAL_MIN_TEXT=0.6
ENRICH_CONCURRENCY=8
IMAGE_FETCH_TIMEOUT_SECONDS=3.0

# Attack-name OCR. One extra crop, read only when the collector number could
# not be - the attacks are then the best way to tell one printing of a Pokemon
# from another. The threshold is high because attack names are short and share
# vocabulary ("Slash" vs "Slashing Strike").
ENABLE_ATTACK_OCR=true
ATTACK_MATCH_THRESHOLD=0.86
# Energy type read from the frame colour. The weakest signal in the pipeline -
# foiling, glare and full-art printings all corrupt it - so a reading below the
# confidence floor is discarded rather than applied weakly.
ENABLE_TYPE_DETECTION=true
TYPE_MIN_CONFIDENCE=0.5
# Print variant: which of a card's own listed prices to show. Neither of these
# ever changes which card was matched, only which price - a reverse holo and
# its normal counterpart, or a 1st Edition and its Unlimited reprint, are the
# same TCGdex card at very different prices.
ENABLE_FIRST_EDITION_OCR=true
ENABLE_FINISH_DETECTION=true
FINISH_MIN_CONFIDENCE=0.5

# Set index (set id -> printed card count), used to match the "/165" half of a
# collector number to the set it was printed in.
SET_INDEX_TTL_SECONDS=86400

# Card-name index (fuzzy OCR correction against real card names)
NAME_INDEX_TTL_SECONDS=86400
NAME_INDEX_TIMEOUT_SECONDS=30.0
NAME_RESOLVE_THRESHOLD=0.72
NAME_SUGGEST_THRESHOLD=0.55
SUGGESTION_LIMIT=60

# --- Performance -----------------------------------------------------------
# Response caches. These remove repeated fetches without changing which cards
# are searched, ranked or enriched: the same pipeline runs, it just stops
# re-downloading rows it already has. Card details (and prices) move slowly;
# searches are a view over the whole database, so they expire much sooner.
CARD_DETAIL_TTL_SECONDS=21600
CARD_DETAIL_CACHE_MAX=5000
SEARCH_CACHE_TTL_SECONDS=600
SEARCH_CACHE_MAX=256

# Build the OCR model at startup instead of inside the first scan. Measured at
# ~5s moved off the first request. Turn off only where startup time matters
# more than first-scan latency (tests, CI).
OCR_WARMUP=true

# Return the per-stage timing breakdown in the scan response. Timings are
# always written to the log; this only controls whether they reach the client.
DEBUG_TIMINGS=false
